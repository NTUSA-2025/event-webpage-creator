# 本機使用：複製為 .dev.vars，Wrangler Pages Functions 會自動讀取。
# DB 與 FILES 是 D1 / R2 binding，須另外設定，不是此檔的文字變數。
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
GOOGLE_WORKSPACE_ADMIN_EMAIL=""
ADMIN_GROUP_EMAIL=""
ENGINEER_GROUP_EMAIL=""
GOOGLE_DRIVE_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""
# 舊版 LLM_API_KEY 仍可作為 OpenAI 金鑰使用；新設定請使用 OPENAI_API_KEY。
SESSION_SECRET=""
PUBLIC_ORIGIN="http://localhost:8788"
